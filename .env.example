# Core Environment
APP_ENV=PRODUCTION
ENVIRONMENT=production
SECRET_KEY=your_secret_key_here

# Database & Caching
DATABASE_URL=postgresql://user:password@localhost:5432/afrianalyze
REDIS_URL=redis://localhost:6379/0

# Supabase (Optional/Alternative to direct Postgres)
SUPABASE_URL=
SUPABASE_KEY=

# Scraper (Firecrawl)
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=http://localhost:3002/v1

# LLM Providers
LLM_API_KEY=your_llm_api_key_here
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Storage (S3)
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# Observability / Analytics
POSTHOG_API_KEY=your_posthog_api_key_here
SENTRY_DSN=https://your_sentry_dsn_here
