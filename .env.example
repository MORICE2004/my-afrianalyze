# Names only. Copy to .env (git-ignored) for local overrides; set real values in the host's dashboard
# (Render / Vercel), never in git. Every variable is explained in docs/ENVIRONMENT.md.
# Local development needs none of these: the defaults run on SQLite at data/afrianalyze.db.

# ---- API (apps/api, server only) ----
APP_ENV=DEVELOPMENT
# PRODUCTION requires a postgresql:// URL (postgres:// is accepted). SECRET: contains the DB password.
DATABASE_URL=
# Comma separated browser origins allowed to call the API. PRODUCTION refuses localhost and *.
CORS_ORIGINS=
# Comma separated host names the API answers to, e.g. api.example.com. Default * (any).
ALLOWED_HOSTS=
SHOW_TRADE_LABELS=true
EXPENSIVE_REQUESTS_PER_MINUTE=30
# Optional. Empty = error reporting off.
SENTRY_DSN=

# ---- Web (apps/web) ----
# PUBLIC: compiled into the browser bundle. Must be https:// for a Vercel production build.
NEXT_PUBLIC_API_URL=
# Server-side rendering's address for the API; defaults to NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=
# PUBLIC: "true" lets search engines index the site. Leave unset until reports are published.
NEXT_PUBLIC_ALLOW_INDEXING=
