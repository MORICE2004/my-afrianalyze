# Names only. Copy to .env (git-ignored) for local overrides; set real values in the host's dashboard
# (Render / Vercel), never in git. Every variable is explained in docs/ENVIRONMENT.md.
# Local development needs none of these: the defaults run on SQLite at data/afrianalyze.db.

# ---- API (apps/api, server only) ----
APP_ENV=DEVELOPMENT
# PRODUCTION requires a postgresql:// URL (postgres:// is accepted). SECRET: contains the DB password.
DATABASE_URL=
# Comma separated browser origins allowed to call the API. PRODUCTION refuses localhost and *.
CORS_ORIGINS=
# Comma separated host names the API answers to, e.g. api.example.com. Default * (any).
ALLOWED_HOSTS=
SHOW_TRADE_LABELS=true
EXPENSIVE_REQUESTS_PER_MINUTE=30
# REQUIRED in PRODUCTION: true or false. Showing DSE prices publicly needs a DSE data licence (docs/COMPLIANCE_NOTES.md).
DSE_PUBLIC_DISPLAY=
# REQUIRED in PRODUCTION. SECRET. Same random value (32+ characters) on the API and the web app: lets the API
# trust the visitor address the web server passes on, so rate limits are per visitor, not per web server.
INTERNAL_PROXY_SECRET=
# Where the client address comes from behind the platform's proxy (Render: cf-connecting-ip, 1 hop).
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=0
# Optional. Empty = error reporting off.
SENTRY_DSN=
# Optional. SECRET. Research copilot provider key; empty = the copilot answers AI_UNAVAILABLE.
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-5-5
COPILOT_DAILY_QUESTIONS=20
# Optional. Product analytics sent from the API (no browser script). ANALYTICS_SALT is a SECRET, 16+ characters.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
ANALYTICS_SALT=

# ---- Web (apps/web) ----
# PUBLIC: compiled into the browser bundle. Must be https:// for a Vercel production build.
NEXT_PUBLIC_API_URL=
# Server-side rendering's address for the API; defaults to NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=
# PUBLIC: "true" lets search engines index the site. Leave unset until reports are published.
NEXT_PUBLIC_ALLOW_INDEXING=
# PUBLIC: the site's own https:// address, for share cards (OpenGraph).
NEXT_PUBLIC_SITE_URL=
